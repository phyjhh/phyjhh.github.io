---
/** A single post or project, like AcademicPages' single layout. */
import Base from "@/layouts/Base.astro";
import T from "@/components/T.astro";
import Icon from "@/components/Icon.astro";
import { UI, readTime } from "@/i18n";
import { formatDate, formatLongDate } from "@/utils/content";
import "katex/dist/katex.min.css";

type Neighbour = { href: string; title: string } | undefined;

type Props = {
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  minutes?: number;
  tags?: string[];
  prev?: Neighbour;
  next?: Neighbour;
};

const {
  title,
  description,
  date,
  updated,
  minutes,
  tags = [],
  prev,
  next,
} = Astro.props;
const showUpdated = updated && formatDate(updated) !== formatDate(date);
---

<Base title={title} description={description}>
  <div class="page__inner-wrap">
    <header>
      <h1 class="page__title">{title}</h1>
      {
        minutes && (
          <p class="page__meta">
            <Icon name="clock" />
            <T {...readTime(minutes)} />
          </p>
        )
      }
      <p class="page__date">
        <strong><Icon name="calendar" /> <T {...UI.published} /></strong>
        <time datetime={date.toISOString()}
          ><T {...formatLongDate(date)} /></time
        >
        {
          showUpdated && (
            <>
              {" · "}
              <T {...UI.updated} />{" "}
              <time datetime={updated.toISOString()}>
                <T {...formatLongDate(updated)} />
              </time>
            </>
          )
        }
      </p>
      <slot name="meta" />
    </header>

    <section class="page__content">
      <slot />
    </section>

    {
      tags.length > 0 && (
        <footer class="page__meta">
          <p class="page__taxonomy">
            <strong>
              <T {...UI.tags} />
            </strong>
            {tags.map(tag => (
              <span class="page__taxonomy-item">{tag}</span>
            ))}
          </p>
        </footer>
      )
    }

    {
      (prev || next) && (
        <nav class="pagination">
          {prev ? (
            <a href={prev.href} class="pagination--pager" title={prev.title}>
              <T {...UI.previous} />
            </a>
          ) : (
            <span class="pagination--pager disabled">
              <T {...UI.previous} />
            </span>
          )}
          {next ? (
            <a href={next.href} class="pagination--pager" title={next.title}>
              <T {...UI.next} />
            </a>
          ) : (
            <span class="pagination--pager disabled">
              <T {...UI.next} />
            </span>
          )}
        </nav>
      )
    }
  </div>
</Base>
