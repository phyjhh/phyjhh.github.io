---
/** Author profile: avatar, name, bio, location, affiliation and links. */
import T from "@/components/T.astro";
import Icon from "@/components/Icon.astro";
import { profile, hasText } from "@/utils/profile";
import { UI } from "@/i18n";

const { name, avatar, bio, location, affiliation, links } = profile;
const has = hasText;
const external = (url: string) => /^https?:/.test(url);
---

<aside class="sidebar" id="author-profile">
  <div class="author">
    {
      avatar && (
        <div class="author__avatar">
          <img
            src={avatar}
            alt={name.en || name.zh}
            width="175"
            height="175"
            decoding="async"
          />
        </div>
      )
    }
    <div class="author__content">
      <h3 class="author__name"><T {...name} /></h3>
      {
        has(bio) && (
          <p class="author__bio">
            <T {...bio} />
          </p>
        )
      }
    </div>
    <button
      type="button"
      class="btn follow-btn"
      id="follow-toggle"
      aria-expanded="false"
      aria-controls="author-urls"
    >
      <T {...UI.follow} />
    </button>
  </div>
  <ul class="author__urls" id="author-urls">
    {
      has(location) && (
        <li>
          <span>
            <Icon name="location" />
            <T {...location} />
          </span>
        </li>
      )
    }
    {
      has(affiliation) && (
        <li>
          <span>
            <Icon name="affiliation" />
            <T {...affiliation} />
          </span>
        </li>
      )
    }
    {
      links.map(link => (
        <li>
          <a
            href={link.url}
            rel={external(link.url) ? "me noopener" : undefined}
            target={external(link.url) ? "_blank" : undefined}
          >
            <Icon name={link.icon} />
            <T {...link.label} />
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<script is:inline>
  (function () {
    const sidebar = document.getElementById("author-profile");
    const button = document.getElementById("follow-toggle");
    button.addEventListener("click", () => {
      const open = sidebar.classList.toggle("open");
      button.setAttribute("aria-expanded", String(open));
    });
  })();
</script>
