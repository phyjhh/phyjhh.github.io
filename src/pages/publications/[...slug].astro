---
import { render, type CollectionEntry } from "astro:content";
import Article from "@/layouts/Article.astro";
import { UI } from "@/i18n";
import { getPublications } from "@/utils/content";

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs
    .filter(pub => pub.body?.trim())
    .map(pub => ({ params: { slug: pub.id }, props: { pub } }));
}

type Props = { pub: CollectionEntry<"publications"> };

const { pub } = Astro.props;
const { data } = pub;
const { Content } = await render(pub);
---

<Article
  title={data.title}
  description={data.description}
  date={data.pubDatetime}
  back={{ href: "/publications/", label: UI.publications }}
>
  <p slot="meta" class="muted">
    {
      data.authors && (
        <>
          {data.authors}
          <br />
        </>
      )
    }
    <em>{data.journal}</em>
    {
      data.doi && (
        <>
          {" · "}
          <a href={data.doi}>DOI</a>
        </>
      )
    }
    {
      data.pdf && (
        <>
          {" · "}
          <a href={data.pdf}>PDF</a>
        </>
      )
    }
  </p>
  <Content />
</Article>
