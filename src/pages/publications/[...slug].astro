---
import { render, type CollectionEntry } from "astro:content";
import Article from "@/layouts/Article.astro";
import T from "@/components/T.astro";
import Icon from "@/components/Icon.astro";
import { UI } from "@/i18n";
import { citationOf, getPublications, hasBody } from "@/utils/content";

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs
    .filter(hasBody)
    .map(pub => ({ params: { slug: pub.id }, props: { pub } }));
}

type Props = { pub: CollectionEntry<"publications"> };

const { pub } = Astro.props;
const { data } = pub;
const { Content } = await render(pub);
---

<Article
  title={data.title}
  description={data.description}
  date={data.pubDatetime}
>
  <div slot="meta" class="publication-meta">
    {data.authors && <p>{data.authors}</p>}
    <p>
      <T {...UI.publishedIn} />
      <em>{data.journal}</em>
    </p>
    <p class="citation">
      <strong><T {...UI.citation} /></strong>
      {citationOf(pub)}
    </p>
    {
      (data.pdf || data.doi) && (
        <p class="archive__item-links">
          {data.pdf && (
            <a href={data.pdf}>
              <Icon name="pdf" />
              <T {...UI.downloadPaper} />
            </a>
          )}
          {data.doi && (
            <a href={data.doi}>
              <Icon name="link" />
              DOI
            </a>
          )}
        </p>
      )
    }
  </div>
  <Content />
</Article>
