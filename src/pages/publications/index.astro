---
import Base from "@/layouts/Base.astro";
import T from "@/components/T.astro";
import PubList from "@/components/PubList.astro";
import { UI } from "@/i18n";
import { getPublications } from "@/utils/content";

const pubs = await getPublications();
---

<Base title={UI.publications}>
  <h1><T {...UI.publications} /></h1>
  {
    pubs.length > 0 ? (
      <PubList pubs={pubs} />
    ) : (
      <p class="muted">
        <T {...UI.noPublications} />
      </p>
    )
  }
</Base>
