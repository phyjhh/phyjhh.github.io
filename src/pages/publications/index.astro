---
import Base from "@/layouts/Base.astro";
import T from "@/components/T.astro";
import PubItem from "@/components/PubItem.astro";
import { UI } from "@/i18n";
import { getPublications } from "@/utils/content";

const pubs = await getPublications();
---

<Base title={UI.publications}>
  <h1 class="page__title"><T {...UI.publications} /></h1>
  <section class="archive">
    {
      pubs.length > 0 ? (
        pubs.map(pub => <PubItem pub={pub} />)
      ) : (
        <p>
          <T {...UI.noPublications} />
        </p>
      )
    }
  </section>
</Base>
