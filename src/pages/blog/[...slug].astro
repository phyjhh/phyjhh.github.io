---
import { render, type CollectionEntry } from "astro:content";
import Article from "@/layouts/Article.astro";
import { getPosts, readingMinutes } from "@/utils/content";

type Post = CollectionEntry<"blog">;
type Neighbour = { href: string; title: string } | undefined;

export async function getStaticPaths() {
  const posts = await getPosts();
  const link = (p?: Post): Neighbour =>
    p && { href: `/blog/${p.id}/`, title: p.data.title };
  // Posts are newest first: "previous" is the older one.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: link(posts[i + 1]), next: link(posts[i - 1]) },
  }));
}

type Props = { post: Post; prev: Neighbour; next: Neighbour };

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<Article
  title={post.data.title}
  description={post.data.description}
  date={post.data.pubDatetime}
  updated={post.data.modDatetime}
  minutes={readingMinutes(post.body)}
  tags={post.data.tags}
  attachments={post.data.attachments}
  prev={prev}
  next={next}
>
  <Content />
</Article>
