---
import { render, type CollectionEntry } from "astro:content";
import Article from "@/layouts/Article.astro";
import T from "@/components/T.astro";
import Icon from "@/components/Icon.astro";
import { UI } from "@/i18n";
import { getPortfolio, hasBody } from "@/utils/content";

export async function getStaticPaths() {
  const items = await getPortfolio();
  return items
    .filter(hasBody)
    .map(item => ({ params: { slug: item.id }, props: { item } }));
}

type Props = { item: CollectionEntry<"portfolio"> };

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);
---

<Article
  title={data.title}
  description={data.description}
  date={data.pubDatetime}
  tags={data.tags}
>
  {
    data.link && (
      <p slot="meta" class="archive__item-links">
        <a href={data.link}>
          <Icon name="external" />
          <T {...UI.projectPage} />
        </a>
      </p>
    )
  }
  {data.image && <img src={data.image} alt="" class="page__teaser" />}
  <Content />
</Article>
