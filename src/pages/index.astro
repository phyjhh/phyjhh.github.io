---
import Base from "@/layouts/Base.astro";
import T from "@/components/T.astro";
import Link from "@/components/Link.astro";
import PostItem from "@/components/PostItem.astro";
import PubItem from "@/components/PubItem.astro";
import { profile } from "@/utils/profile";
import { SITE } from "@/config";
import { UI } from "@/i18n";
import { getPosts, getPublications } from "@/utils/content";

const posts = (await getPosts()).slice(0, SITE.recentPosts);
const pubs = (await getPublications()).slice(0, 3);
const { about, interests } = profile;
---

<Base>
  <div class="page__inner-wrap">
    <header>
      <h1 class="page__title"><T {...UI.aboutMe} /></h1>
    </header>
    <section class="page__content">
      <div class="zh" lang="zh-CN">
        {about.zh.map(p => <p>{p}</p>)}
      </div>
      <div class="en" lang="en">
        {about.en.map(p => <p>{p}</p>)}
      </div>

      {
        interests.length > 0 && (
          <>
            <h2>
              <T {...UI.researchInterests} />
            </h2>
            <ul>
              {interests.map(item => (
                <li>
                  <T {...item} />
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        pubs.length > 0 && (
          <>
            <h2>
              <T {...UI.selectedPublications} />
            </h2>
            {pubs.map(pub => (
              <PubItem pub={pub} />
            ))}
            <p>
              <Link href="/publications/" label={UI.allPublications} />
            </p>
          </>
        )
      }

      <h2><T {...UI.recentPosts} /></h2>
      {
        posts.length > 0 ? (
          <>
            {posts.map(post => (
              <PostItem post={post} />
            ))}
            <p>
              <Link href="/blog/" label={UI.allPosts} />
            </p>
          </>
        ) : (
          <p>
            <T {...UI.noPosts} />
          </p>
        )
      }
    </section>
  </div>
</Base>
