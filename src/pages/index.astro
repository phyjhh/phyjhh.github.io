---
import Base from "@/layouts/Base.astro";
import T from "@/components/T.astro";
import Link from "@/components/Link.astro";
import PostList from "@/components/PostList.astro";
import PubList from "@/components/PubList.astro";
import profile from "@/data/profile.json";
import { SITE } from "@/config";
import { UI } from "@/i18n";
import { getPosts, getPublications } from "@/utils/content";

const posts = (await getPosts()).slice(0, SITE.recentPosts);
const pubs = await getPublications();
const { name, tagline, affiliation, bio, links } = profile;
---

<Base>
  <section class="profile">
    <h1><T {...name} /></h1>
    {
      (tagline.zh || tagline.en) && (
        <p class="tagline">
          <T {...tagline} />
        </p>
      )
    }
    {
      (affiliation.zh || affiliation.en) && (
        <p class="muted">
          <T {...affiliation} />
        </p>
      )
    }
    <p class="links">
      {
        links.map((link, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <Link href={link.url} label={link.label} />
          </>
        ))
      }
    </p>
    <div class="bio zh" lang="zh-CN">
      {bio.zh.map(p => <p>{p}</p>)}
    </div>
    <div class="bio en" lang="en">
      {bio.en.map(p => <p>{p}</p>)}
    </div>
  </section>

  {
    pubs.length > 0 && (
      <section>
        <h2>
          <a href="/publications/">
            <T {...UI.publications} />
          </a>
        </h2>
        <PubList pubs={pubs} />
      </section>
    )
  }

  <section>
    <h2><T {...UI.recentPosts} /></h2>
    {
      posts.length > 0 ? (
        <>
          <PostList posts={posts} />
          <p>
            <Link href="/blog/" label={UI.allPosts} />
          </p>
        </>
      ) : (
        <p class="muted">
          <T {...UI.noPosts} />
        </p>
      )
    }
  </section>
</Base>
