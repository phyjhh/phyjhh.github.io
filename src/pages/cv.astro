---
import Base from "@/layouts/Base.astro";
import T from "@/components/T.astro";
import Icon from "@/components/Icon.astro";
import { profile, hasText } from "@/utils/profile";
import { UI } from "@/i18n";
import { citationOf, getPublications } from "@/utils/content";

const { cv } = profile;
const pubs = await getPublications();
const has = hasText;
---

<Base title={UI.cv}>
  <h1 class="page__title"><T {...UI.cv} /></h1>
  <section class="page__content">
    {
      cv.pdf && (
        <p>
          <a href={cv.pdf} class="btn">
            <Icon name="pdf" />
            <T {...UI.downloadCv} />
          </a>
        </p>
      )
    }
    {
      cv.sections.map(section => (
        <>
          <h2>
            <T {...section.title} />
          </h2>
          <ul class="cv-list">
            {section.items.map(item => (
              <li>
                <span class="cv-period">{item.period}</span>
                <div>
                  <strong>
                    <T {...item.title} />
                  </strong>
                  {has(item.detail) && (
                    <div class="cv-detail">
                      <T {...item.detail} />
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </>
      ))
    }
    {
      pubs.length > 0 && (
        <>
          <h2>
            <T {...UI.publications} />
          </h2>
          <ol class="cv-publications">
            {pubs.map(pub => (
              <li>{citationOf(pub)}</li>
            ))}
          </ol>
        </>
      )
    }
  </section>
</Base>
